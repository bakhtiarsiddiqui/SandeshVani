# SandeshVani Backend Environment Placeholders
# Do not commit real secrets or production credentials.

APP_NAME=SandeshVani
APP_ENV=local
DEPLOYMENT_ENVIRONMENT=development
ENABLE_LOCAL_MAIL_SINK=true

# Local Mailpit SMTP. Mailpit UI: http://127.0.0.1:8025
DEV_MAIL_SMTP_HOST=127.0.0.1
DEV_MAIL_SMTP_PORT=1025
DEV_MAIL_SMTP_STARTTLS=false
DEV_MAIL_SMTP_USERNAME=
DEV_MAIL_SMTP_PASSWORD=
DEV_MAIL_FROM=no-reply@sandeshvani.local
AUTH_RECOVERY_EMAIL_LIMIT=5
AUTH_RECOVERY_IP_LIMIT=30
AUTH_RECOVERY_RATE_WINDOW_SECONDS=900
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# Private audience CSV staging; use a private persistent volume in deployments.
AUDIENCE_IMPORT_STORAGE_DIR=./var/private/audience-imports
AUDIENCE_IMPORT_MAX_BYTES=26214400
AUDIENCE_IMPORT_MAX_ROWS=100000

POSTGRES_DB=sandeshvani
POSTGRES_USER=sandeshvani_app
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Alembic only: use a separate migration-owner connection in deployments.
# Leave the role empty when the migration URL already authenticates as that owner.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_ROLE=

REDIS_URL=redis://localhost:6379/0

# JWT and browser-session security
# Local development may omit the PEM values; ephemeral asymmetric keys are then
# generated for that process only. Production requires a matching configured
# key pair and fails before the application starts if either value is unsafe.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=sandeshvani-api
JWT_AUDIENCE=sandeshvani-api
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production: use a distinct random value of at least 32 bytes, set
# COOKIE_SECURE=true, and set ALLOWED_ORIGINS to a JSON array of exact HTTPS
# origins, e.g. ["https://app.sandeshvani.in"]. Never use wildcard origins.
CSRF_SECRET=dev_csrf_secret_32_bytes_minimum_key_change_in_prod
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
