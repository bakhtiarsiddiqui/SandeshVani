          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"approve\",\n  \"reviewer_note\": \"Attempting to re-approve.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ai/campaigns/{{requestId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ai",
            "campaigns",
            "{{requestId}}",
            "approve"
          ]
        }
      }
    },
