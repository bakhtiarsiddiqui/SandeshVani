          "raw": "{\n  \"channel\": \"sms\",\n  \"language\": \"hi\",\n  \"key_facts\": {\n    \"event\": \"Test\",\n    \"date\": \"2026-12-01\",\n    \"venue\": \"Delhi\",\n    \"cost\": \"Free\",\n    \"contact\": \"1800\"\n  }\n}"
        },
        "url": {
